LIVE_DOMAIN=https://yourdomain.com

## External Links
NEXT_PUBLIC_ARTIST_PORTFOLIO=https://your-artist-portfolio-url.com
NEXT_PUBLIC_WHITEPAPER_URL=https://your-whitepaper-url.com

## Supabase Configuration
# SUPABASE_URL is server-only (no NEXT_PUBLIC_ prefix) — read by both the
# anon client (src/lib/supabase/server.ts) and the whitelist feature's
# service-role client (src/lib/whitelist/supabase.ts). Neither runs
# client-side today, so nothing needs this inlined into the browser bundle.
SUPABASE_DOMAIN=your-project-ref.supabase.co
SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

## App Links
NEXT_PUBLIC_APP_DAO=https://your-app.com/dao

## PostHog Analytics
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=phc_your_project_token_here
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

## Hero Marquee Text
## Pattern: Odd numbers (1,3,5,7...) = Main text with icons
##          Even numbers (2,4,6,8...) = Separator text
## src/lib/marquee-config.ts reads up to NEXT_PUBLIC_MARQUEE_TEXT_20 — add
## or remove entries as needed within that range.
NEXT_PUBLIC_MARQUEE_TEXT_1=Your marquee text here
NEXT_PUBLIC_MARQUEE_TEXT_2=Your separator text here
NEXT_PUBLIC_MARQUEE_TEXT_3=Your marquee text here
NEXT_PUBLIC_MARQUEE_TEXT_4=Your separator text here
NEXT_PUBLIC_MARQUEE_TEXT_5=Your marquee text here
NEXT_PUBLIC_MARQUEE_TEXT_6=Your separator text here
NEXT_PUBLIC_MARQUEE_TEXT_7=Your marquee text here
NEXT_PUBLIC_MARQUEE_TEXT_8=Your separator text here

# Auth.js — Sign in with X (free OAuth 2.0 app, NOT the paid X Data API —
# this feature makes no X Data API calls of any kind)
AUTH_TWITTER_ID=your-x-oauth2-client-id
AUTH_TWITTER_SECRET=your-x-oauth2-client-secret
AUTH_SECRET=generate-a-random-32-byte-secret

# Campaign config (single campaign) — used only to build the follow/repost
# links shown to applicants, not for any API verification. Account is a
# username (no @); the post has no identifier other than its numeric ID
# (the number after /status/ in the tweet's URL).
CAMPAIGN_TARGET_ACCOUNT_USERNAME=your-x-username-here
CAMPAIGN_TARGET_POST_ID=your-target-post-id-here
CAMPAIGN_NAME=Encoteki Whitelist
